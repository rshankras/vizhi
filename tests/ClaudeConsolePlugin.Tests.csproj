<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Remove="fixtures/**/*.cs" />
    <ProjectReference Include="fixtures/UiaHostFixture/UiaHostFixture.csproj" ReferenceOutputAssembly="false" />
    <None Update="desktop/commands.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ClaudeConsolePlugin.Tests</AssemblyName>
    <RootNamespace>Loupedeck.ClaudeConsolePlugin.Tests</RootNamespace>

    <!-- The suite runs on macOS and Windows (since #56); the Unix file-mode tests split on
         platform explicitly, so the CA1416 platform-compatibility analyzer only adds noise here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Keep test output out of the plugin's bin/ tree (which gets packaged into the .lplug4). -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Same location the plugin resolves PluginApi from. Needed at COMPILE time here too: tests
         that touch an action class see its PluginDynamicCommand base type, and a plain
         ProjectReference doesn't forward a HintPath reference transitively. -->
    <PluginApiDir Condition="$(OS) == 'Windows_NT'">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginApiDir Condition="$(OS) != 'Windows_NT'">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests COMPILE the engine and BOTH agents rather than referencing a product.
         Each product assembly contains the engine plus only its own agent, so referencing two of
         them would mean two copies of every engine type and an ambiguity error on the first line
         that used one. Compiling the sources keeps one suite covering both agents.
         It also means no ProjectReference to a plugin project, so running the tests can no longer
         write the dev .link into the LIVE Logi plugin directory as a side effect — which the
         SkipPluginLink dance existed to prevent. -->
    <Compile Include="..\src\Core\**\*.cs" />
    <Compile Include="..\tools\windows\ClaudeConsoleFocus\TabSelection.cs" />
    <Compile Include="..\tools\windows\ClaudeConsoleInject\SessionInputLock.cs" />
    <Compile Include="..\tools\windows\ClaudeConsoleHook\WindowsHookProcessQuery.cs" />
    <!-- The Windows desktop helper's matching rules, kept free of UI Automation so the suite
         can hold them to the macOS helper's answers on any platform. -->
    <Compile Include="..\tools\windows\VizhiDesktopUia\UiaMatching.cs" />
    <Compile Include="..\tools\windows\VizhiDesktopUia\UiaRootCache.cs" />
    <Compile Include="..\tools\windows\VizhiDesktopUia\ServeProtocol.cs" />
    <Compile Include="..\src\Agents\**\*.cs" />
    <!-- Each product's application binding broke clean installs in 1.8.0-1.8.4 by naming a process
         that doesn't exist on the running OS, so every product's belongs under test. The desktop
         Plugin declaration is included too: its HasNoApplication flag decides whether Options+
         ever consults that binding. -->
    <Compile Include="..\src\Products\*\*Application.cs" />
    <Compile Include="..\src\Products\VizhiDesktop\VizhiDesktopPlugin.cs" />
    <!-- Desktop-owned registration (see the header in those files). The product glob above
         deliberately compiles only *Application.cs; this is the one product folder whose
         logic the suite must cover, because nothing else in the engine exercises it. -->
    <Compile Include="..\src\Products\VizhiDesktop\Registration\**\*.cs" />
    <!-- Exercise the uninstall override on a fresh object, without starting the live bridge. -->
    <Compile Include="..\src\Products\ClaudeConsole\ClaudeConsolePlugin.cs" />
    <Compile Include="..\src\Products\ClaudeConsole\ClaudePluginLifecycle.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Codex launcher, so CodexCliAdapter.HookScriptContents() resolves here too. NOTE: this
         proves the READER works, not that the shipped package embedded it — that is a packaging
         property, checked by tools/verify-package.sh at pack time. -->
    <EmbeddedResource Include="..\scripts\codex-hook.sh">
      <LogicalName>CodexConsole.codex-hook.sh</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyUiaHostFixture" AfterTargets="Build">
    <ItemGroup>
      <UiaFixtureFiles Include="fixtures/UiaHostFixture/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiaFixtureFiles)" DestinationFolder="$(TargetDir)uia-fixture" />
  </Target>
</Project>
